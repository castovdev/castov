{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.castovdev/castov",
  "description": "Zero-telemetry local developer execution layer for port inspection, CIDR subnetting, ID decoding, and Unix timestamps.",
  "repository": {
    "url": "https://github.com/castovdev/castov",
    "source": "github"
  },
  "version": "1.3.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "castov",
      "version": "1.3.3",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
