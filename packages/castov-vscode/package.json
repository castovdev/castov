{
  "name": "castov-vscode",
  "displayName": "Smart Hover Pack - Castov",
  "description": "Instant tooltips on hover (Timestamp, Cron, Chmod, CIDR), 1-click MCP Server setup for Cursor/VS Code, UUID v4/v7, Hash (SHA-256/MD5), Secrets, JWT & Base64.",
  "version": "0.1.5",
  "publisher": "castov",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0b1120",
    "theme": "dark"
  },
  "author": "Abdelmalik Benidir / Castov <https://www.castov.com>",
  "license": "MIT",
  "homepage": "https://www.castov.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/castovdev/castov.git"
  },
  "bugs": {
    "url": "https://github.com/castovdev/castov/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "mcp",
    "cursor",
    "cron",
    "chmod",
    "cidr",
    "hash",
    "sha256",
    "secret",
    "unix",
    "timestamp",
    "uuid",
    "uuidv7",
    "jwt",
    "base64",
    "castov"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "castov.setupMcpServer",
        "title": "Castov: Setup MCP Server (Cursor / VS Code)",
        "category": "Castov"
      },
      {
        "command": "castov.insertUuidV4",
        "title": "Castov: Insert UUID v4",
        "category": "Castov"
      },
      {
        "command": "castov.insertUuidV7",
        "title": "Castov: Insert UUID v7 (Time-Ordered)",
        "category": "Castov"
      },
      {
        "command": "castov.insertUnixTimestamp",
        "title": "Castov: Insert Current Unix Timestamp",
        "category": "Castov"
      },
      {
        "command": "castov.convertTimestamp",
        "title": "Castov: Convert Selected Timestamp to Date",
        "category": "Castov"
      },
      {
        "command": "castov.decodeJwt",
        "title": "Castov: Decode Selected JWT Token",
        "category": "Castov"
      },
      {
        "command": "castov.hashSelection",
        "title": "Castov: Hash Selection (SHA-256, SHA-512, MD5, SHA-1)",
        "category": "Castov"
      },
      {
        "command": "castov.generateSecret",
        "title": "Castov: Generate Secure Secret / API Key",
        "category": "Castov"
      },
      {
        "command": "castov.base64Encode",
        "title": "Castov: Base64 Encode Selection",
        "category": "Castov"
      },
      {
        "command": "castov.base64Decode",
        "title": "Castov: Base64 Decode Selection",
        "category": "Castov"
      },
      {
        "command": "castov.urlEncode",
        "title": "Castov: URL Encode Selection",
        "category": "Castov"
      },
      {
        "command": "castov.urlDecode",
        "title": "Castov: URL Decode Selection",
        "category": "Castov"
      },
      {
        "command": "castov.openCastov",
        "title": "Castov: Open castov.com in Browser",
        "category": "Castov"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "castov.convertTimestamp",
          "when": "editorHasSelection",
          "group": "castov@1"
        },
        {
          "command": "castov.decodeJwt",
          "when": "editorHasSelection",
          "group": "castov@2"
        },
        {
          "command": "castov.hashSelection",
          "when": "editorHasSelection",
          "group": "castov@3"
        },
        {
          "command": "castov.base64Encode",
          "when": "editorHasSelection",
          "group": "castov@4"
        },
        {
          "command": "castov.base64Decode",
          "when": "editorHasSelection",
          "group": "castov@5"
        },
        {
          "command": "castov.urlEncode",
          "when": "editorHasSelection",
          "group": "castov@6"
        },
        {
          "command": "castov.urlDecode",
          "when": "editorHasSelection",
          "group": "castov@7"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish:openvsx": "ovsx publish castov-vscode-0.1.5.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  }
}
