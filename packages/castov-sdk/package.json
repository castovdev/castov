{
  "name": "@castov/sdk",
  "version": "1.0.0",
  "description": "Zero-dependency, zero-server developer utilities: Unix timestamps, ID detector (ObjectId, Snowflake, UUIDv7, ULID), cron explainer, IANA time zone converter with DST handling, UUID v4/v7, Base64, hashing, and JWT decoding. Works in Node.js, Deno, Bun, edge runtimes, and browsers.",
  "keywords": ["uuid", "uuidv7", "nanoid", "base64", "hash", "sha256", "unix", "timestamp", "cron", "timezone", "dst", "snowflake", "ulid", "objectid", "jwt", "castov", "zero-dependency"],
  "homepage": "https://castov.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benidira/timeforge.git",
    "directory": "packages/castov-sdk"
  },
  "bugs": "https://github.com/benidira/timeforge/issues",
  "license": "MIT",
  "author": "Castov <https://castov.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "test": "node --test test/sdk.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}