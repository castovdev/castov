      "args": ["-y", "@modelcontextprotocol/server-filesystem@0.6.2", "./src"],
      "env": {
        "GITHUB_TOKEN": "${env:GITHUB_PAT}",
        "id": "c37e0b03-60bf-4a48-8117-e654d264a73f",
        "revision": "a435dd1e23f5b78901234567890abcdef1234567",
        "sha256_digest": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      }
    },
    "secure-database": {
      "command": "node",
      "args": ["bin/db-mcp.js@v1.0.0"],
      "env": {
        "DATABASE_URL": "${env:PROD_DATABASE_URL}"
      }
    },
    "local-dev-server": {
      "url": "http://localhost:8080/mcp"
    }
