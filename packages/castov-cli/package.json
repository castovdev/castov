{
  "name": "castov",
  "version": "1.0.0",
  "description": "Castov in your terminal: Unix timestamps, ID detector (ObjectId, Snowflake, UUIDv7, ULID), cron explainer, IANA time zone converter with DST handling, UUIDs (v4/v7), Base64, hashes, and JWT decoding. Zero-server, zero-config.",
  "keywords": ["cli", "castov", "unix", "timestamp", "cron", "timezone", "dst", "detect", "snowflake", "ulid", "objectid", "uuid", "uuidv7", "base64", "hash", "jwt"],
  "homepage": "https://castov.com",
  "license": "MIT",
  "author": "Castov <https://castov.com>",
  "type": "module",
  "bin": {
    "castov": "dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "node --test test/cli.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "castov-sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  }
}
